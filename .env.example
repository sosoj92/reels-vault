# Copie locale : .env (ignore par Git). Ne jamais versionner de vraie cle.
# Telegram : le plus simple est  python telegram_setup.py  (remplit ces trois valeurs).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=

# ---- LLM Router (llm_router.py) ------------------------------------------------
# Modeles (vides = valeurs par defaut du routeur).
OLLAMA_MODEL=qwen3:1.7b
MISTRAL_MODEL=mistral-small-latest
ANTHROPIC_MODEL=

# Cles API : optionnelles. Absente = fournisseur simplement desactive.
# L'abonnement Claude.ai ne donne PAS acces a l'API Anthropic.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

LLM_LOCAL_ENABLED=true
LLM_CLOUD_ENABLED=true

# light = local si dispo et PC libre, sinon Mistral ; standard = Mistral ; complex = Claude.
LLM_DEFAULT_LIGHT=local
LLM_DEFAULT_STANDARD=mistral
LLM_DEFAULT_COMPLEX=anthropic

# Donnees sensibles (sante, finances privees, documents confidentiels) : local uniquement.
LLM_SENSITIVE_CLOUD_ALLOWED=false
# Donnees personnelles (emails, telephones...) : cloud seulement si true.
LLM_PERSONAL_CLOUD_ALLOWED=false

# Budgets (EUR, estimes a partir des tokens) : jamais depasses silencieusement.
LLM_DAILY_BUDGET_EUR=1.00
LLM_MONTHLY_BUDGET_EUR=10.00
LLM_CLAUDE_DAILY_BUDGET_EUR=0.50

# PC : Qwen n'est charge que si le PC est assez libre ; dechargement apres inactivite.
LLM_LOCAL_MAX_CPU=75
LLM_LOCAL_MIN_FREE_MB=1800
OLLAMA_IDLE_UNLOAD_MINUTES=10

# Transcription locale des vocaux
# VAULT_WHISPER_MODEL=small
