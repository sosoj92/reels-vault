# Copie locale : .env (ignore par Git). Ne jamais versionner de vraie cle.
# Telegram : python telegram_setup.py remplit ces trois valeurs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=

# ---- LLM Router (llm_router.py) : python llm_setup.py saisit et teste les cles -----
# Qwen local (Ollama)
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_IDLE_UNLOAD_MINUTES=10
LLM_LOCAL_MAX_CPU=75
LLM_LOCAL_MIN_FREE_MB=1800

# Gemini Developer API (cloud par defaut pour standard / complexe)
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite
GEMINI_STANDARD_MODEL=gemini-2.5-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
GEMINI_COMPLEX_THINKING_BUDGET=1024
# Plafond optionnel (vide = aucun) ; prix estimes USD / million de tokens (0 = gratuit)
GEMINI_DAILY_BUDGET_USD=
GEMINI_PRICE_IN_USD=0
GEMINI_PRICE_OUT_USD=0

# OpenRouter : RESERVE de secours, jamais le cloud par defaut
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_STANDARD_MODEL=openai/gpt-4o-mini
OPENROUTER_COMPLEX_MODEL=google/gemini-2.5-flash
# Au plus 2 modeles de secours, separes par des virgules (jamais de modele tres couteux)
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_DAILY_BUDGET_USD=0.25
OPENROUTER_MONTHLY_BUDGET_USD=
# Plus d'appel automatique quand le credit restant atteint cette reserve
OPENROUTER_RESERVE_USD=1.00
# Credit de depart (utilise si le credit reel n'est pas lisible par l'API)
OPENROUTER_INITIAL_CREDIT_USD=7.00

# Claude API : optionnelle, hors des chaines par defaut. L'abonnement Claude.ai ne
# donne PAS acces a l'API Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Mistral : desactive, non utilise.
MISTRAL_API_KEY=

# Politique
LLM_LOCAL_ENABLED=true
LLM_CLOUD_ENABLED=true
LLM_CHAIN_LIGHT=local,gemini,openrouter
LLM_CHAIN_STANDARD=gemini,local,openrouter
LLM_CHAIN_COMPLEX=gemini,openrouter
LLM_SENSITIVE_CLOUD_ALLOWED=false
LLM_PERSONAL_CLOUD_ALLOWED=false
LLM_DAILY_BUDGET_EUR=1.00
LLM_MONTHLY_BUDGET_EUR=10.00

# Transcription locale des vocaux
# VAULT_WHISPER_MODEL=small
